# === GitTok Environment Variables ===
# Copy this file to .env.local and fill in your values

# NextAuth.js
NEXTAUTH_URL=https://your-domain.onrender.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional: server-side token for reading public GitHub Discussions when visitors are not logged in
GITHUB_TOKEN=github_pat_or_classic_token_with_public_repo_scope

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis
REDIS_URL=rediss://default:your_token@your-host.upstash.io:6379

# Baidu Translate API (https://fanyi-api.baidu.com)
BAIDU_TRANSLATE_APPID=your_appid
BAIDU_TRANSLATE_API_KEY=your_api_key

# Feed mode
USE_MOCK_FEED=false
NEXT_PUBLIC_USE_MOCK_FEED=false
